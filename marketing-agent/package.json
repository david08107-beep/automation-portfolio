{
  "name": "marketing-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "node build/src/server/main.js",
    "test": "node --test build/tests/*.test.js",
    "test:browser": "node scripts/browser-check.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "playwright": "1.56.1",
    "typescript": "5.9.3"
  }
}
